# Copy to vm.env and edit. Read by vmctl.sh (laptop) and run_all.sh (VM). No secrets here.

# --- Azure (laptop side) ---
RG=rg-project-c                      # resource group; deleting it removes everything
VM=vm-project-c
LOCATION=eastus                      # prices in vm/README.md are for eastus
SIZE=Standard_E8s_v6                 # 8 vCPU / 64 GB, $0.529/h (E8s_v5 is not offered to this subscription in eastus); fallback Standard_E16s_v6 (128 GB, $1.058/h)
DISK_CONTROLLER=NVMe                 # v6 sizes need NVMe; use SCSI for v5
DISK_GB=256
DISK_SKU=Premium_LRS                 # P15 $38.01/month; StandardSSD_LRS (E15) $19.20/month is cheaper and slower
ADMIN=azureuser
SSH_PUB=$HOME/.ssh/id_ed25519.pub
AUTO_SHUTDOWN_UTC=0700               # daily deallocation at 07:00 UTC (2-3 a.m. US Eastern) as a safety net

# --- Resource limits for the pipeline (VM side); the laptop defaults are 2 threads / 2 GB ---
C_THREADS=8
C_MEM=48GB                           # leave ~16 GB for the OS and Python
C_MAX_TEMP=150GB
C_GT_THREADS=8
AUTO_DEALLOCATE=1                    # 1 = the VM deallocates itself when run_all.sh finishes or fails
